OPENAI_API_KEY=
OPENCODE_API_KEY=
QDRANT_URL=http://127.0.0.1:6333
# Optional for local Qdrant; required by hosted providers such as Qdrant Cloud.
QDRANT_API_KEY=
REDIS_URL=redis://127.0.0.1:6379/0
PUBLIC_ORIGIN=http://127.0.0.1:3000
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# Optional synthetic demo binding; never production authentication.
AERONOVA_DEMO_CUSTOMER=CUST-1001

# Optional Phoenix tracing; the application works without Phoenix.
AERONOVA_ENABLE_OTEL=0
PHOENIX_ENABLED=true
PHOENIX_PROJECT_NAME=aeronova-rag
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
# Browser-accessible Phoenix base URL, used for request-specific trace links.
PHOENIX_PUBLIC_URL=http://localhost:6006
